# Everything is optional for local development: with no DATABASE_URL the app
# uses an embedded Postgres (PGlite) stored in .data/.

# Postgres connection string (Neon pooled URL in production).
DATABASE_URL=
# Direct, non-pooled connection used only for migrations (optional).
DATABASE_URL_UNPOOLED=

# Public base URL used in emailed links, e.g. https://app.example.com
APP_URL=

# Long random string (32+ characters) used to derive signing-link secrets.
# Required in production. Generate with: openssl rand -hex 32
APP_SECRET=

# Email. Without any of these, signing links are shown for manual sharing.
#
# Option 1, Resend: used when both of these are set. The EMAIL_FROM domain must be
# verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# e.g. EMAIL_FROM="Signgate <agreements@example.com>"
#
# Option 2, SMTP (Gmail or Google Workspace by default): used when Resend is not
# configured and both SMTP_USER and SMTP_PASS are set. Emails are sent from SMTP_USER.
# For Gmail, turn on 2-step verification and create an app password at
# https://myaccount.google.com/apppasswords; the normal account password will not work.
SMTP_USER=
SMTP_PASS=
# Only needed for a provider other than Gmail. Port 465 uses TLS from the start;
# 587 starts plain and upgrades (STARTTLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# AI-assisted field detection (Anthropic). Without it, rule-based detection is used.
ANTHROPIC_API_KEY=

# Secret that authorizes /api/cron (reminders, expiry, webhook retries).
CRON_SECRET=
